# Azure OpenAI (chat + vision). Copy to .env and fill in.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Vision-capable deployment for the critic (defaults to AZURE_OPENAI_DEPLOYMENT when unset)
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# World backend: mock | http | auto (auto = http if the mod answers /health, else mock)
COPILOT_BRIDGE=auto
COPILOT_MOD_URL=http://127.0.0.1:7777
# Place intermediate stages in-game while building (demo mode)
COPILOT_LIVE_PREVIEW=false
COPILOT_PORT=8000
