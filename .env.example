# Azure OpenAI (chat + vision). Copy to .env and fill in.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Vision-capable deployment for the critic (defaults to AZURE_OPENAI_DEPLOYMENT when unset)
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# API flavour: auto | chat | responses. auto = responses when the endpoint URL ends in /responses (a pasted
# Foundry "target URI" like https://<res>.services.ai.azure.com/openai/v1/responses works as-is), else chat;
# switches to responses automatically if the deployment rejects chat completions.
AZURE_OPENAI_API=auto
# gpt-5.x / o-series only: reasoning effort for tool loops (low is fastest)
AZURE_OPENAI_REASONING_EFFORT=low
# Optional cheaper deployment for the router / describe / critic fix rounds (defaults to the main one)
MODEL_FAST=

# Latency (T2): hard cap per chat turn and the planned stage schedule inside it (seconds)
COPILOT_HARD_BUDGET_S=300
COPILOT_PLAN_BUDGET_S=150
# Individual op calls per stage before the model must batch in run_script
COPILOT_OP_CAP=12

# World backend: mock | http | auto (auto = http if the mod answers /health, else mock)
COPILOT_BRIDGE=auto
COPILOT_MOD_URL=http://127.0.0.1:7777
# Place intermediate stages in-game while building (demo mode)
COPILOT_LIVE_PREVIEW=false
COPILOT_PORT=8000

# T3 chat visibility: place the build live after the blocking and detailing stages (default true;
# `/cp preview on|off` overrides per session). Verbose per-op lines: `/cp verbose on|off` in game.
LIVE_PREVIEW=true
