# Azure OpenAI (GPT-5.4 line). Copy to .env and fill in.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=preview
AZURE_OPENAI_COMPOSE_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EDIT_DEPLOYMENT=gpt-5.4-mini

# Optional
# CRAFTPILOT_SCHEMATICS_DIR=~/Library/Application Support/minecraft/schematics/craftpilot
# CRAFTPILOT_MC_VERSION=26.2           # which data/blocks_<version>.json filters the block catalog (1.21.1 also shipped)
# CRAFTPILOT_MC_DATA_VERSION=4903      # 26.2; 3955 for 1.21.1, 3578 for 1.20.2
# CRAFTPILOT_DEFAULT_BOUNDS=25x30x25
# CRAFTPILOT_SAFETY_LIMIT=256x256x256
# CRAFTPILOT_LLM_TIMEOUT=240   # seconds per model call; compose takes 30-120s on gpt-5.4-mini
# CRAFTPILOT_PORT=7778                 # the FastAPI service; the mod's bridge owns 7777
# CRAFTPILOT_MOD_URL=http://127.0.0.1:7777
# CRAFTPILOT_PLACE_GAP=2               # air blocks between the player and the building
# CRAFTPILOT_PLACE_SINK=0              # how far the plinth row sinks below the player's feet
# CRAFTPILOT_PLACE_CHUNK=1500          # blocks placed per game tick (minimum; big builds get more)
# CRAFTPILOT_PLACE_CHUNK_MAX=6000      # never more than this per tick
# CRAFTPILOT_PLACE_SECONDS=6           # aim to finish placing a build in about this long
# CRAFTPILOT_PLACE_DELAY_MS=60         # pause between chunks
# CRAFTPILOT_PLACE_TERRAIN=1           # survey the ground (mod /heightmap) and seat the build on it; 0 = plinth at your feet
# ---------------------------------------------------------------------------------------------
# Live agent (agent/ + mod/): the Minecraft copilot server. Same resource works; see agent/README.md.
# ---------------------------------------------------------------------------------------------
# Azure OpenAI (chat + vision). Copy to .env and fill in.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# Vision-capable deployment for the critic (defaults to AZURE_OPENAI_DEPLOYMENT when unset)
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# API flavour: auto | chat | responses. auto = responses when the endpoint URL ends in /responses (a pasted
# Foundry "target URI" like https://<res>.services.ai.azure.com/openai/v1/responses works as-is), else chat;
# switches to responses automatically if the deployment rejects chat completions.
AZURE_OPENAI_API=auto
# gpt-5.x / o-series only: reasoning effort for tool loops (low is fastest)
AZURE_OPENAI_REASONING_EFFORT=low
# Per-call timeout (s) and attempts. A normal call takes 2–35 s; a hung request costs the whole timeout
# before the retry, so keep this short for live demos (default 120).
AZURE_OPENAI_TIMEOUT_S=60
AZURE_OPENAI_MAX_ATTEMPTS=2
# Optional cheaper deployment for the router / describe / critic fix rounds (defaults to the main one)
MODEL_FAST=

# Latency (T2): hard cap per chat turn and the planned stage schedule inside it (seconds)
COPILOT_HARD_BUDGET_S=300
COPILOT_PLAN_BUDGET_S=150
# Individual op calls per stage before the model must batch in run_script
COPILOT_OP_CAP=12

# World backend: mock | http | auto (auto = http if the mod answers /health, else mock)
COPILOT_BRIDGE=auto
COPILOT_MOD_URL=http://127.0.0.1:7777
# Place intermediate stages in-game while building (demo mode)
COPILOT_LIVE_PREVIEW=false
COPILOT_PORT=8000

# T3 chat visibility: place the build live after the blocking and detailing stages (default true;
# `/cp preview on|off` overrides per session). Verbose per-op lines: `/cp verbose on|off` in game.
LIVE_PREVIEW=true
