# Azure OpenAI (GPT-5.4 line). Copy to .env and fill in. The endpoint may be the resource root or a pasted
# Foundry target URI such as https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses (everything
# from /openai on is ignored).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=preview
# Building composer / editor. gpt-5.4 has no real-time quota on this resource; gpt-5.4-mini (500K TPM) does.
# AZURE_OPENAI_DEPLOYMENT=<name> is accepted as an alias for both when they are unset.
AZURE_OPENAI_COMPOSE_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EDIT_DEPLOYMENT=gpt-5.4-mini

# Optional
# CRAFTPILOT_SCHEMATICS_DIR=~/Library/Application Support/minecraft/schematics/craftpilot
# CRAFTPILOT_MC_VERSION=26.2           # which data/blocks_<version>.json filters the block catalog (1.21.1 also shipped)
# CRAFTPILOT_MC_DATA_VERSION=4903      # 26.2; 3955 for 1.21.1, 3578 for 1.20.2
# CRAFTPILOT_DEFAULT_BOUNDS=25x30x25
# CRAFTPILOT_SAFETY_LIMIT=256x256x256
# CRAFTPILOT_LLM_TIMEOUT=240   # seconds per model call; compose takes 30-120s on gpt-5.4-mini
# CRAFTPILOT_PORT=7778                 # the FastAPI service; the mod's bridge owns 7777
# CRAFTPILOT_MOD_URL=http://127.0.0.1:7777
# CRAFTPILOT_PLACE_GAP=2               # air blocks between the player and the building
# CRAFTPILOT_PLACE_SINK=0              # how far the plinth row sinks below the player's feet
# CRAFTPILOT_PLACE_CHUNK=1500          # blocks placed per game tick (minimum; big builds get more)
# CRAFTPILOT_PLACE_CHUNK_MAX=6000      # never more than this per tick
# CRAFTPILOT_PLACE_SECONDS=6           # aim to finish placing a build in about this long
# CRAFTPILOT_PLACE_DELAY_MS=60         # pause between chunks
# CRAFTPILOT_PLACE_TERRAIN=1           # survey the ground (mod /heightmap) and seat the build on it; 0 = plinth at your feet
# CRAFTPILOT_ROUTE_DEPLOYMENT=gpt-5.4-mini  # building-vs-object router tie-break call; defaults to the edit deployment
# CRAFTPILOT_ROUTE_TIMEOUT=12               # seconds for that one small low-effort call (never the compose timeout)
# CRAFTPILOT_ROUTE_LLM=1                    # 0 = word rules only; /build object|building in-game always override
# CRAFTPILOT_COMPOSE_EFFORT=low             # reasoning effort when composing a building: low (~8 s) | medium (30-100 s)

# Objects (statues, creatures, vehicles, props, named landmarks): text -> FLUX image -> Hunyuan3D mesh -> voxels.
# Lives in src/craftpilot/objects/; the local 3D worker is set up per tools/README.md.
# CRAFTPILOT_OBJECT_DEPLOYMENT=        # model that writes the object brief; else AZURE_OPENAI_EDIT_DEPLOYMENT
# CRAFTPILOT_IMAGE_DEPLOYMENT=FLUX-1.1-pro   # images deployment on the same resource (openai/v1 images API)
# CRAFTPILOT_RECON_PYTHON=tools/.venv-3d/bin/python   # interpreter with torch + Hunyuan3D / TripoSR
# CRAFTPILOT_RECON_PORT=7790           # the resident reconstruction server (tools/recon_server.py), auto-started
# CRAFTPILOT_RECON_ENGINE=hunyuan      # hunyuan | triposr
# CRAFTPILOT_RECON_SERVER=1            # 0 = run tools/recon_worker.py per request instead of the server
# CRAFTPILOT_HUNYUAN=1                 # recon server: 0 = do not load Hunyuan3D at startup
